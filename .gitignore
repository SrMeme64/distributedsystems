# Local environment files; do not commit credentials.
.env
.env.*

# Credentials, private keys, and certificates.
secrets/
**/secrets/
*.secret
*.credentials
credentials.json
*_credentials.json
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# Local database exports and backups.
*.sql.gz
*.dump
*.bak
backups/
**/backups/

# Python bytecode from local test runs.
__pycache__/
*.pyc

# Capturas locales de las PoC: cada operador guarda sus resultados aqui.
PoCs/evidencias/*
!PoCs/evidencias/README.md

