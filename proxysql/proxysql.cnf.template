datadir="/var/lib/proxysql"

admin_variables=
{
    admin_credentials="admin:__ADMIN_PASSWORD__"
    mysql_ifaces="0.0.0.0:6032"
}

mysql_variables=
{
    threads=2
    max_connections=2048
    interfaces="0.0.0.0:6033"
    monitor_username="__MONITOR_USER__"
    monitor_password="__MONITOR_PASSWORD__"
    monitor_galera_healthcheck_interval=2000
    monitor_galera_healthcheck_timeout=1000
    connect_timeout_server=3000
    connect_timeout_server_max=10000
}

# All Galera nodes start in the writer hostgroup. The Galera hostgroup
# definition below moves them to the reader/backup/offline groups according to
# their wsrep state, so no node has to be named as a permanent writer.
mysql_servers =
(
    {
        address="galera1"
        port=3306
        hostgroup=10
        max_connections=30
        weight=1
        comment="galera1"
    },
    {
        address="galera2"
        port=3306
        hostgroup=10
        max_connections=30
        weight=1
        comment="galera2"
    },
    {
        address="galera3"
        port=3306
        hostgroup=10
        max_connections=30
        weight=1
        comment="galera3"
    }
)

mysql_galera_hostgroups =
(
    {
        writer_hostgroup=10
        backup_writer_hostgroup=20
        reader_hostgroup=30
        offline_hostgroup=40
        active=1
        max_writers=1
        writer_is_also_reader=1
        max_transactions_behind=100
        comment="distributed-cluster"
    }
)

mysql_users =
(
    {
        username="__APP_USER__"
        password="__APP_PASSWORD__"
        default_hostgroup=10
        default_schema="__APP_DB__"
        max_connections=200
        transaction_persistent=1
        comment="store application user"
    }
)

mysql_query_rules =
(
    {
        rule_id=1
        active=1
        match_pattern="^SELECT .*FOR UPDATE"
        destination_hostgroup=10
        apply=1
        comment="locking reads stay on the writer"
    },
    {
        rule_id=2
        active=1
        match_pattern="^SELECT"
        destination_hostgroup=30
        apply=1
        comment="plain reads go to the reader hostgroup"
    }
)
